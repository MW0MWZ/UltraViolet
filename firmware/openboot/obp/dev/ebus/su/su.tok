id: @(#)su.tok 1.0 26/11/07
purpose: The SuperIO's UART for the mouse (su@14,3062f8)
copyright: Copyright 2026 Andy Taylor

\ The release's serial driver (dev/southbridge/isa-devices/serial) for the
\ PC87332's 16550-compatible UARTs, as the Ultra 5/10 has them: one at
\ 3f8 for the keyboard, one at 2f8 for the mouse, each 1200 baud, 8N1.

Fcode-Version3

headerless
h# 8            constant tty-size
h# 1            constant #channels
my-address      constant tty-base

" su"		name
" serial"	device-type

: en+ ( xdr,len int -- xdr',len' ) encode-int encode+ ;

\ (The mouse's port: its properties in an Ultra 10's order)
my-space encode-int  tty-base en+  tty-size en+  " reg" property
0 0 " mouse" property
0 0 " port-a-ignore-cd" property
1 encode-int " interrupts" property

: default-tty-mode     " 1200,8,n,1,-" ;
defer default-ttya-mode
defer default-ttyb-mode
: init-tty ( -- )
   ['] default-tty-mode to default-ttya-mode
   ['] default-tty-mode to default-ttyb-mode
;
init-tty

fload ${BP}/dev/serial/mode-data.fth
fload ${BP}/dev/ebus/su/io.fth
fload ${BP}/dev/serial/mode-decode.fth
fload ${BP}/dev/serial/ttydriver.fth

: write ( adr len -- #written ) uwrite ;

end0
