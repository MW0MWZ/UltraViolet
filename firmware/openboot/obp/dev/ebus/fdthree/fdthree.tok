\ OpenBoot release it is part of (see LICENSE).
id: @(#)fdthree.tok 1.0 26/11/07
purpose: The SuperIO's floppy disk controller (an 82077) and drive: fdthree
copyright: Copyright 2026 Andy Taylor

\ The controller runs as a PC's does (PC-AT mode). Its transfers are made
\ here without DMA (its non-DMA mode: the data through its FIFO a byte at
\ a time), of the 512-byte sectors of a 3.5" 1.44 MB disk (80 cylinders, 2
\ heads, 18 sectors a track). As the Ultra 10's driver has them, the
\ device's blocks are the sectors, read and written one to a call, and
\ the controller's results are judged as that driver judges them. The
\ Ultra 5/10's drive ejects by hand. With no drive answering, the node's
\ status is "disabled", and the selftest, open and boot say so as an Ultra
\ 10 does.

Fcode-version3

headerless

-1 value fdc				\ the controller's registers, while mapped
: fdc-map ( -- )
   fdc -1 = if  h# 3023f0 h# 14 8 " map-in" $call-parent to fdc  then
;
: fdc-unmap ( -- )
   fdc -1 <> if  fdc 8 " map-out" $call-parent  -1 to fdc  then
;

: dor! ( b -- )  fdc 2+ rb!  ;
: msr@ ( -- b )  fdc 4 + rb@  ;
: fifo@ ( -- b )  fdc 5 + rb@  ;
: fifo! ( b -- )  fdc 5 + rb!  ;
: ccr! ( b -- )  fdc 7 + rb!  ;

h# 80 constant rqm			\ main status: ready for a byte
h# 20 constant ndm			\ in a non-DMA execution phase

: timed-out? ( when -- flag )  get-msecs - 0<  ;
\ (Time-limited, a second; an Ultra 10's driver counts polls of the main
\ status register.)
: wait-rqm ( -- ok? )
   get-msecs d# 1000 +  begin
      msr@ rqm and if  drop true exit  then
      dup timed-out?
   until  drop false
;
: cmd! ( b -- )
   wait-rqm 0= if  ." Floppy chip not ready for command" cr  abort  then
   fifo!
;

\ A command's results: ST0 to ST2 and the sector's address, as many as it
\ gives
7 buffer: st
: results ( n -- )  0 ?do  wait-rqm drop  fifo@ st i + c!  loop  ;
: st0 ( -- b )  st c@  ;
: st1 ( -- b )  st 1+ c@  ;
: st-clear ( -- )  st 7 erase  ;

\ Reset: drive 0 selected, its motor off; the four drives' interrupts
\ sensed; the step rate, head times and non-DMA mode; 500 kbit/s.
h# df constant specify0
h# 03 constant specify1
0 value motor?
: fdc-reset ( -- )
   0 dor!  1 ms  h# 0c dor!  false to motor?  d# 10 ms
   4 0 do  8 cmd! 2 results  loop
   3 cmd!  specify0 cmd!  specify1 cmd!
   0 ccr!
;
: motor-on ( -- )  motor? 0= if  h# 1c dor!  d# 500 ms  true to motor?  then  ;
: motor-off ( -- )  h# 0c dor!  false to motor?  ;

\ A seek's end: once the controller and drive are no longer busy, its
\ interrupt sensed (ST0, or 80 if there was none).
: sense ( -- st0 )  8 cmd!  2 results  st0  ;
: wait-seek ( -- st0 )
   get-msecs d# 3000 +  begin
      msr@ h# 11 and 0= if
         sense dup h# 80 <> if  nip exit  then  drop
      then
      1 ms  dup timed-out?
   until  drop h# 80
;
: seek-ok? ( st0 -- ok? )  h# f0 and h# 20 =  ;
\ One recalibrate: its ST0. (The drive is selected only with its motor
\ on: the controller gates each drive select with its motor bit.)
: recal ( -- st0 )  motor-on  7 cmd! 0 cmd!  wait-seek  ;
\ Twice: a drive more than 79 steps out reaches track 0 the second time.
: recalibrate ( -- ok? )
   recal seek-ok?  dup 0= if  drop  recal seek-ok?  then
;
: seek-to ( cyl head -- ok? )
   h# f cmd!  2 lshift cmd!  dup cmd!  wait-seek seek-ok?	( cyl ok? )
   swap st 1+ c@ = and
;
\ The drive's status (ST3) with a head selected
: drive-status ( head -- st3 )  4 cmd!  2 lshift cmd!  1 results  st0  ;

\ The controller set up for use, as an Ultra 10's driver checks it, at
\ open and in the selftest: reset, with no interrupt left to sense; the
\ timings it was given read back; the drive recalibrated; a seek to track
\ 2 and back, the track 0 signal off and on; and each head selectable.
\ (Which commands make each check is not known; these are the ones that
\ test what each message names.)
: fdc-init ( -- ok? )
   fdc-reset
   sense h# 80 <> if  ." Floppy chip initialization failed." cr  false exit  then
   h# 0e cmd!  d# 10 0 do  wait-rqm drop  fifo@  loop	( pcn0..3 s0 s1 x x x x )
   2drop 2drop  specify1 =  swap specify0 =  and	( pcn0..3 ok? )
   >r 2drop 2drop r>
   0= if  ." Floppy chip registers read back incorrectly." cr  false exit  then
   recalibrate drop  st0 h# 10 and if
      ." Recalibrate failed.  The floppy drive is either missing," cr
      ." improperly connected, or defective." cr
      false exit
   then
   2 0 seek-to 0= if  ." Seek to track 2 failed." cr  false exit  then
   0 drive-status h# 10 and if  ." Track 0 reported when on track 2." cr  false exit  then
   0 0 seek-to 0= if  ." Seek to track 0 failed." cr  false exit  then
   0 drive-status h# 10 and 0= if  ." Track 0 not reported." cr  false exit  then
   0 drive-status 4 and if  ." Head select is 1; should be 0." cr  false exit  then
   1 drive-status 4 and 0= if  ." Head select is 0; should be 1." cr  false exit  then
   true
;

d# 512 constant /sector
d# 18 constant #sectors
2 constant #heads
d# 80 constant #cylinders

: chs ( block# -- sector0 head cyl )  #sectors /mod  #heads /mod  ;

\ A read or write command for one sector: the seek, then the command and
\ its eight bytes (the sector's address, 512 bytes, the track's end at
\ the sector: the controller ends with "end of track", as an abnormal
\ end).
: sector-cmd ( block# cmd -- ok? )
   >r chs					( sector0 head cyl )
   2dup swap seek-to 0= if  3drop r> drop  st 1+ 6 erase  false exit  then
   r> cmd!  over 2 lshift cmd!  cmd! cmd!	( sector0 )
   1+ dup cmd!  2 cmd!  cmd!  h# 1b cmd!  h# ff cmd!
   true
;

\ The execution phase: a byte each time the controller asks, while it is
\ in the phase. No request within the time: the controller reset, and the
\ first result byte FF (no diskette, as a rule).
0 value writing?
: pio ( adr len -- done? )
   0 ?do
      wait-rqm 0= if  drop false unloop exit  then
      msr@ ndm and 0= if  leave  then
      writing? if  dup i + c@ fifo!  else  fifo@ over i + c!  then
   loop  drop true
;
: timed-out ( -- )  fdc-reset  st-clear  h# ff st c!  ;

\ As the Ultra 10's driver judges them: a read is good when it ended
\ abnormally (as a non-DMA read ends, with no terminal count) or with an
\ overrun; a write only when it ended normally.
: read-ok? ( -- flag )  st0 h# c0 and h# 40 =  st1 h# 10 and 0<>  or  ;
: write-ok? ( -- flag )  st0 h# c0 and 0=  ;

: transfer ( adr block# -- ok? )
   writing? if  h# 45  else  h# 46  then  sector-cmd 0= if  drop false exit  then
   /sector pio 0= if  timed-out false exit  then
   7 results
   writing? if  write-ok?  else  read-ok?  then
;

\ One block, retried after a data error alone (ST1 20), up to 8 tries,
\ with the drive recalibrated before each (up to 4 times, until ST0 shows
\ no equipment check).
: retry-recal ( -- )  4 0 do  recal h# 10 and 0= if  leave  then  loop  ;
: rw-block ( adr block# -- ok? )
   motor-on
   0  begin					( adr block# tries )
      >r 2dup transfer if  2drop r> drop true exit  then
      st1 h# 20 <> if  2drop r> drop false exit  then
      r> 1+  dup 8 >= if  3drop false exit  then
      retry-recal
   again
;

\ At the probe, as an Ultra 10's own OpenBoot leaves the node: a drive
\ answering, its unit number (0) and "manual" (the disk changed by hand);
\ none, the node disabled.
: floppy-probe ( -- )
   fdc-map fdc-reset  recalibrate  motor-off fdc-unmap
   if
      0 encode-int " unit" property
      0 0 encode-bytes " manual" property
   else
      " disabled" encode-string " status" property
   then
;
floppy-probe

0 instance value label-package
0 instance value deblocker
0 instance value offset-low
0 instance value offset-high

: init-deblocker ( -- ok? )
   " " " deblocker" $open-package dup to deblocker  0<>
;
: init-label-package ( -- ok? )
   0 to offset-high  0 to offset-low
   my-args " disk-label" $open-package dup to label-package  if
      0 0 " offset" label-package $call-method  to offset-high to offset-low
      true
   else  false  then
;

: fdc-off ( -- )  fdc -1 <> if  motor-off fdc-unmap  then  ;

external

: dma-alloc ( n -- adr )  alloc-mem  ;
: dma-free ( adr n -- )  free-mem  ;
: block-size ( -- n )  /sector  ;
\ (One block a transfer, as read-blocks makes it.)
: max-transfer ( -- n )  /sector  ;
: #blocks ( -- n )  #sectors #heads * #cylinders *  ;

\ As the Ultra 10's: one block whatever the count asked for, at byte
\ block# * 512; 1 if it was transferred, else 0, and nothing shown.
: read-blocks ( adr block# #blocks -- #read )
   drop  false to writing?  rw-block  if 1 else 0 then
;
: write-blocks ( adr block# #blocks -- #written )
   drop  true to writing?  rw-block  if 1 else 0 then
;

: close ( -- )
   label-package ?dup if  close-package  0 to label-package  then
   deblocker ?dup if  close-package  0 to deblocker  then
   fdc-off
;

: open ( -- ok? )
   " reg" get-my-property if  ." Missing reg property on floppy" cr  false exit  then
   2drop
   fdc-map  fdc-init 0= if  fdc-off false exit  then
   init-deblocker 0= if  ." Can't open deblocker package" cr  close false exit  then
   init-label-package 0= if  ." Can't open disk label package" cr  close false exit  then
   true
;

: seek ( offset.low offset.high -- ok? )
   offset-low offset-high d+  " seek" deblocker $call-method
;
: read ( adr len -- actual )  " read" deblocker $call-method  ;
: write ( adr len -- actual )  " write" deblocker $call-method  ;
: load ( adr -- size )  " load" label-package $call-method  ;

: eject ( -- )  ." Press the EJECT button now" cr  ;

: reset ( -- )  fdc-off  ;

\ The selftest: the controller set up and checked, and the disk's first
\ sector read.
: selftest ( -- 0 | -1 )
   ." Testing floppy disk system.  A formatted disk should be in the drive." cr
   fdc-map  fdc-init 0= if  fdc-off -1 exit  then
   /sector alloc-mem  dup 0 false to writing?  rw-block  swap /sector free-mem
   if
      ." Test succeeded." cr 0
   else
      st0 h# ff = if
         ." No diskette, or incorrect format." cr
      else
         ." Can't read the first sector." cr
      then  -1
   then
   fdc-off
;

end0
